	quest.2AC0FE608759AD53.quest_desc: ["&e&lCreate&r modunun dalış zırhı yalnızca koruma sağlamaz; su altında inşa etmek ve çalışmak için pek çok güçlendirme de sunar."]
	quest.2AC0FE608759AD53.quest_subtitle: "7 ila 15"
	quest.2AC0FE608759AD53.title: "&9Dalış Zırhı"
	quest.2E0F82F7E1B74033.quest_desc: [
		"&d&lArs Elemental&r &2Toprak Zırhı&r!\\n"
		"&2Toprak&r gliflerini güçlendirerek toprak ve zehir tabanlı büyülerin etkisini artırır.\\n\\n&2Toprak&r tabanlı kaynaklardan alınan hasarı azaltır.\\n\\nTam set giyildiğinde alınan &2Toprak&r tabanlı hasarın bir kısmını manaya da dönüştürür."
	]
	quest.2E0F82F7E1B74033.quest_subtitle: "15"
	quest.2E0F82F7E1B74033.title: "&2Jeomansör Kıyafeti"
	quest.2EAA6BE598C83F24.quest_desc: [
		"&d&lArs Elemental&r &3Su Zırhı!\\n"
		"&3Su&r gliflerini güçlendirir.\\n\\n&3Su&r tabanlı kaynaklardan alınan hasarı azaltır.\\n\\nTam set giyildiğinde alınan &3Su&r tabanlı hasarın bir kısmını manaya dönüştürür."
	]
	quest.2EAA6BE598C83F24.quest_subtitle: "15"
