	quest.0F1D6F4729CC38F3.title: "Kaburga Zırh Süslemesi"
	quest.10AA2B20D86747F7.quest_desc: ["&bFerricore&r, Demir ile aynı istatistiklere sahiptir ancak Demirin keşke bende de olsaydı diyeceği başka yetenekleri vardır! \\n\\nNeler yapabilecekleri hakkında daha fazla bilgi edinmek için eşya açıklamalarına göz at!"]
	quest.10AA2B20D86747F7.quest_subtitle: "15"
	quest.10AA2B20D86747F7.title: "&bFerricore Zırhı"
	quest.1245126B4338C019.quest_desc: [
