		"{image:atm:textures/questpics/basicarmor/armor_sentry.png width:100 height:150 align:center}"
	]
	quest.338BD467EBE6EE1F.quest_subtitle: "Yağmacı Karakolu"
	quest.338BD467EBE6EE1F.title: "Nöbetçi Zırh Süslemesi"
	quest.3403D7502F7BC897.quest_desc: ["Kelimenin tam anlamıyla yenilmezsin; hiçbir şey sana vurup hasar veremez. \\n\\nŞu anda &cNetherit Zırhını&r bir &eKuantum &bYükseltme&r ile yükseltmen gerekiyor, ancak &6&lATM Team&r bu tarifi zorlaştırmak için çalışıyor! \\n\\nBunu durdurmak için yapabileceğin hiçbir şey yok! &lBWAHAHAHAHA"]
	quest.3403D7502F7BC897.quest_subtitle: "Yenilmez"
	quest.3403D7502F7BC897.title: "&eKuantum &bZırhı&r (&l&7MI&r)"
	quest.34D14B807A2DAC0F.quest_desc: ["Bütün eğlencenin &5&lMekanism&r ve &l&7Modern Industrialization'a&r kalacağını mı düşündünüz? \\n\\nBu &5Kuantum Zırhının&r varsayılan özellikleri &cNetherit Zırhına&r benzer, fakat &aMekaSuit&r gibi Enerjiyi kalkan olarak kullanabilir. \\nDaha da güçlü olmanızı sağlayacak yükseltmeler de takılabilir! Uçuş, Gece Görüşü ve hatta yeniden şarj olma gibi. \\n\\nAma en iyi yanı, Depolama Sisteminize bağlanabilmesidir! Böylece nerede olursanız olun sistemden otomatik olarak Enerji ve istediğiniz Eşyayı alabilirsiniz.\\n\\nÜstelik tam seti giymek, &aRadyasyonun&r sizi öldürmesini önleyebilir."]
	quest.34D14B807A2DAC0F.quest_subtitle: "Sağlayabileceğiniz kadar Enerji"
	quest.34D14B807A2DAC0F.title: "&5Kuantum Zırhı&r (&l&bAE2&r)"
