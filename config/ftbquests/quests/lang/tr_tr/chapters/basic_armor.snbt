	quest.3FCEF8FF45E51608.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_quartz.png width:100 height:150 align:center}"]
	quest.44CC11E67ADD0556.quest_desc: ["&d&lForbidden and Arcanus&r modundaki &5Draco Arcanus&r zırhı, iyi koruma özellikleri sunan yüksek kademeli bir settir. Modun &5Obsidiyen&r zırhının yükseltilmiş hâlidir; gerekli malzemeleri edinmek için modun &6Hephaestus Forge&r sistemine geçmeniz gerekir."]
