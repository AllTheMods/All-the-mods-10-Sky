	quest.1245126B4338C019.quest_subtitle: "Orman Köşkü"
	quest.1245126B4338C019.title: "Sinirbozan Zırh Süslemesi"
	quest.13517D17E6BF015F.quest_desc: ["&bElmas Zırh&r ve birkaç &aInferium eşyası&r ile &aInferium Zırhı&r üretebiliriz! \\n\\nBu zırh, Tamirat sistemiyle de yükseltilebilir!"]
	quest.13517D17E6BF015F.quest_subtitle: "21"
	quest.13517D17E6BF015F.title: "&aInferium Zırh"
	quest.17A68C4E9E9EA2B7.quest_desc: ["&eAltın Zırh&r, Demir ile &7Deri&r arasında yer alır. Ancak Dayanıklılığı &7Deri&r'ye çok daha yakındır. \\n\\nBiraz &eAltın Zırh&r giyerken Piglinlerin sana karşı Tarafsız olması dışında pek bir kullanımı yoktur."]
	quest.17A68C4E9E9EA2B7.quest_subtitle: "11"
	quest.17A68C4E9E9EA2B7.title: "&eAltın Zırh"
	quest.19F58E291A543228.quest_desc: [
		"&d&lArs&r zırhlarının &eAltın&r sürümü!"
		""
		"Temel savunması çok düşük olan, ancak &5sihirli&r yükseltmeler açısından en büyük potansiyele sahip bir &5sihir&r zırhı setidir. Diğer zırh setleri kadar hasara dayanamaz, fakat büyü gücünüzü büyük ölçüde artırır.\\n\\nBelki bunda Onarıma bile ihtiyacınız yoktur..."
	]
	quest.19F58E291A543228.quest_subtitle: "11"
	quest.19F58E291A543228.title: "&5Sorcerer Kıyafeti"
	quest.1A8440C0048EEB02.quest_desc: ["&cBlazegold&r, Demir ile aynı istatistiklere sahiptir ancak Demirin keşke bende de olsaydı diyeceği başka yetenekleri vardır! \\n\\nNeler yapabilecekleri hakkında daha fazla bilgi edinmek için eşya açıklamalarına göz at!"]
	quest.1A8440C0048EEB02.quest_subtitle: "15"
	quest.1A8440C0048EEB02.title: "&cBlazegold Zırhı"
	quest.1C27C74722A19FC1.quest_desc: ["Çok miktarda pahalı &l&5Mekanism&r eşyası kullanarak &5Unobtainium Zırhını&r &aMekaSuit&r'e yükseltebilirsin! \\n\\nMekaSuit enerji depolar; hasar aldığında kalplerin azalmak yerine enerji tüketilir. \\n\\nYükseltme birimleri kullanarak onu daha da güçlendirebilirsin!"]
	quest.1C27C74722A19FC1.quest_subtitle: "Sağlayabileceğin kadar Enerji"
	quest.1C27C74722A19FC1.title: "&aMekaSuit"
