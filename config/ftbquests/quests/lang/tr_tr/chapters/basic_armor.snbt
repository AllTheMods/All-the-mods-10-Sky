	quest.79D3055DE0EEA6B0.quest_desc: [
		"&d&lArs Elemental&r &cAteş Zırhı&r!\\n"
		"Bu set &cAteş&r gliflerini güçlendirerek ateş tabanlı büyüleri daha etkili kılar.\\n\\n&cAteş&r hasarına karşı direnç sağlar; tam set giyildiğinde bu direnç artar.\\n\\nTam set giyildiğinde alınan &cAteş&r tabanlı hasarın bir kısmını manaya da dönüştürür."
	]
	quest.79D3055DE0EEA6B0.quest_subtitle: "15"
	quest.79D3055DE0EEA6B0.title: "&cPyromancer Outfit"
	quest.7B500E0577BDFF8F.quest_desc: ["&6Bronz&r, &6Bakır&r ve Kalay karışımıdır. \\n\\nAlaşımı yapmanın bir düzine farklı yolu var, sana doğru yolu söylemeyeceğim."]
	quest.7B500E0577BDFF8F.quest_subtitle: "18"
	quest.7B500E0577BDFF8F.title: "&6Bronz Zırh"
	quest.7C1D407CF67786F6.quest_desc: [
		"&d&lArs Elemental&r &eHava Zırhı&r!\\n"
		"&eHava&r gliflerini güçlendirir; bu, yıldırım büyüleri ve Leap gibi hareketlilik büyüleri için yararlı olabilir.\\n\\n&eHava&r tabanlı kaynaklardan alınan hasarı azaltır. Tam set giyildiğinde alınan &eHava&r tabanlı hasarın bir kısmını manaya dönüştürür."
	]
	quest.7C1D407CF67786F6.quest_subtitle: "15"
	quest.7C1D407CF67786F6.title: "&fAethermancer Outfit"
	quest.7F11ABFB2E21B7E4.quest_desc: ["Zırh, &l&2Minecraft&r'ın çok önemli bir parçasıdır; seni hasardan korur. \\n\\nFarklı zırh parçaları farklı Zırh Puanları sağlar. Zırhın ne kadar etkili olduğunu bu puanlar belirler; ne kadar çoksa o kadar iyi!\\n\\nÇoğu zırh, zırh süslemeleriyle süslenebilir. Görünümü değiştirmek için bir zırh parçasını, bir zırh süslemesi ve renklendirme malzemesiyle birlikte kullan!"]
	quest.7F11ABFB2E21B7E4.title: "&l&bTemel Zırhlar&r"
	quest.7FABB77A60E7962C.quest_desc: ["Obsidiyeni &bElmaslarla&r aşılayarak İşlenmiş Obsidiyen Tozu elde edebiliriz! \\n\\nArdından &7Osmiyumu&r bu malzemeye sıkıştırarak külçe biçimini elde edebiliriz. \\n\\nSon olarak bu külçeleri, &6Allthemodium Zırhından&r bile daha iyi değerlere sahip zırha dönüştürebiliriz!"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5İşlenmiş Obsidiyen Zırhı"
