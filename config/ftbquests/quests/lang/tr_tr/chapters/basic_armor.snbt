	quest.28408BFAA54E4FC6.quest_desc: ["&7Deri Zırh&r, elde edebileceğiniz en kötü vanilla zırh setidir. \\n\\nBunun asıl nedeni, &c&lMojang'ın&r onu diğer zırhlardan önce edinmenizi beklemesidir. \\n\\nAma ben o kadar çok &8İ&fn&8e&fk&r bulmakta zorlandığım için onu neredeyse hiç edinmiyorum. Kusura bakma, &c&lMojang&r!"]
	quest.28408BFAA54E4FC6.quest_subtitle: "7"
	quest.28408BFAA54E4FC6.title: "&7Deri Zırh"
	quest.2A4FE9644F3B9DC1.quest_desc: ["&2Prudentium&r'un yükseltilmiş versiyonu."]
	quest.2A4FE9644F3B9DC1.quest_subtitle: "26"
