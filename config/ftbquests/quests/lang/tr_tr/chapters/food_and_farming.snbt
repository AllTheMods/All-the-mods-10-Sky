	quest.28C9EDBF6607E180.title: "DİLİMLENMİŞ EKMEKTEN BU YANA EN İYİ ŞEY"
	quest.2E9C035EEE7E5C34.quest_desc: ["Klasik Kayış. Hayvanları çiftlik alanına götürmek için bunu kullan.\\n\\nBu cevherle aynı şey değildir."]
	quest.2E9C035EEE7E5C34.quest_subtitle: "İyi yolculuklar küçük Köpekçik"
	quest.2E9C035EEE7E5C34.title: "Bunu Eski Usul yapıyoruz"
	quest.2FBF54AC8273E8DF.quest_desc: ["Productive Trees, her biri kendine özgü ürünlere sahip pek çok yeni ağaç ekler. Yapraklarını kırarak bu meyveleri toplayabilirsiniz."]
	quest.2FBF54AC8273E8DF.quest_subtitle: "Meyveler, meyveler ve daha çok meyve"
	quest.2FBF54AC8273E8DF.title: "Productive Trees"
	quest.34F29677E6B5E40C.quest_desc: ["Hasat başına elde edilen ürün miktarını artırır; kırmızı gübreyle birlikte kullanılamaz."]
