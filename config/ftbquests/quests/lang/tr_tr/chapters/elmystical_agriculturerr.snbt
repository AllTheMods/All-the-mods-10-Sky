	quest.21A90474590FCDB8.quest_desc: ["\"Ocak\", daha yüksek hız ve daha iyi verimlilik için yükseltilebilen temel oyundaki Ocağın geliştirilmiş bir sürümüdür."]
	quest.21A90474590FCDB8.title: "\"Ocak\""
	quest.224CE21E56703F6E.quest_desc: ["Değnek, İnfüzyon Sunağını tetiklemek için kullanılır. İnfüzyon işlemini başlatmak için sunağa sağ tıklamanız yeterlidir."]
	quest.224CE21E56703F6E.quest_subtitle: "Sen Bir Büyücüsün!"
	quest.224CE21E56703F6E.title: "&2Değnek"
	quest.23C36E4B5DCEBFDD.quest_desc: ["Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya &2Topluluktan bir katkıda bulunan&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan, herkese açık hiçbir pakette açık izin olmadan kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.260F9C98DC2E485B.quest_subtitle: "Aşama: &b4"
	quest.26A7746051A4A079.quest_subtitle: "Aşama: &63"
	quest.27A0BCE75F198A82.quest_subtitle: "Aşama: &e1"
	quest.27E8ED4B5F8127F9.quest_subtitle: "Aşama: &b4"
