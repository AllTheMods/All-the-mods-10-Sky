	quest.2A59C2FE4AAA79D4.quest_subtitle: "Kademe: &a2"
	quest.2A7E3F2CD335EAD0.quest_desc: ["&aÖz Ekipmanları&r üretme yolculuğunuza başlamak için öncelikle Inferium Zırhı yapmalısınız.\\n\\nBu ekipmanlar, tıpkı Özler gibi daha üst kademelere yükseltilebilir. Ayrıca &bTamirci Masası&r kullanarak zırhlarınıza özel &9geliştirmeler&r ekleyebilirsiniz!"]
	quest.2A7E3F2CD335EAD0.title: "&aInferium Zırh"
	quest.2AECDD9E2DEA708C.quest_subtitle: "Aşama: &a2"
	quest.2C73E3C5113BF2AC.quest_desc: ["Bip bip! Ben bir koyunum."]
	quest.2C73E3C5113BF2AC.quest_subtitle: "Aşama: &a2"
	quest.2C9C9CB71941DC01.quest_desc: ["4 Prudentium Özünü İnfüzyon Kristali ile birleştirerek elde edilen 3. Kademe Öz."]
	quest.2C9C9CB71941DC01.quest_subtitle: "Aşama: &63"
	quest.2C9C9CB71941DC01.title: "&cTertium"
	quest.2DDA04088C8220D2.quest_desc: ["Prosperity Parçaları, modun temel üretim malzemelerindendir. Ruh Kumunu Iron Sieve veya daha üst kademesiyle eleyerek elde edebilirsiniz."]
	quest.2DDA04088C8220D2.quest_subtitle: "Nihayet Prosperity!"
	quest.2DDA04088C8220D2.title: "&bProsperity Parçaları"
	quest.30E9255DEC69C061.title: "&4Supremium Aletler"
	quest.32B01BD789F0B037.quest_desc: ["Uyandırılmış Supremium ve diğer kademeli özler, &6Productive Bees&r modu sayesinde arılarla otomatik olarak üretilebilir."]
	quest.32B01BD789F0B037.title: "Uyandırılmış Supremium'u Otomatikleştirmek"
	quest.3339445194568D77.title: "&2Prudentium Aletler"
	quest.3384308C78D86059.quest_subtitle: "Aşama: &a2"
	quest.33D23C65E7274A8F.quest_desc: ["Supremium Özünü uyandırmak için Uyanış Sunağı, 4 adet Uyanış Kaidesi ve 4 adet &cÖz Kabı&r üretmeniz gerekir.\\n\\nÖz Kaplarını doldurmak için temel element özleri gereklidir: Ateş, Su, Toprak ve Hava."]
	quest.33D23C65E7274A8F.title: "&dUyanış&r"
	quest.37B297640F537383.quest_desc: ["Ayarlanmamış Geliştirme, İnfüzyon Sunağı üzerinde çeşitli zırh/alet geliştirmeleri üretmek için temel malzeme olarak kullanılır. Bu geliştirmeler sayesinde &eAcele&r, &1Gece Görüşü&r, &bDüşme Hasarı Direnci&r, &6Ateş Direnci&r ve çok daha fazla özel güce kavuşabilirsiniz!"]
	quest.37B297640F537383.title: "&fAyarlanmamış Geliştirme"
