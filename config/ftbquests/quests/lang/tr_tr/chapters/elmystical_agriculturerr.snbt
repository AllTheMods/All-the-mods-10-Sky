{
	quest.04A7AA70C23830FF.quest_desc: ["Oraklar, geniş alanlardaki organik materyalleri temizlemek için kullanılan aletlerdir. Kırdığınız bloğun etrafındaki alanda yer alan blokları da topluca kırarlar."]
	quest.04B6E31120663EB2.quest_subtitle: "Aşama: &a2"
