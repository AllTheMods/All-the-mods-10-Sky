	quest.3EA2578C3A56FAE8.quest_desc: ["Ruh Çıkarıcı, bir kavanoz yerleştirip yaratık eşyalarını kullanarak Ruh Kavanozlarını doldurmanızı sağlar. Örneğin Çürük Et eklemek bir miktar Zombi Ruhu kazandırır."]
	quest.3EBCBED3FD033117.quest_subtitle: "Kademe: &a2"
	quest.408D8B1CFBA22BAF.quest_desc: ["Wither'a Dayanıklı bloklar, tuğlalar ve camlar aşırı yüksek patlama direncine sahiptir; Wither veya Ender Ejderhası tarafından asla yok edilemezler."]
	quest.408D8B1CFBA22BAF.title: "&0Wither'a Dayanıklı Bloklar"
	quest.409A92D40F539485.quest_subtitle: "Aşama: &e1"
	quest.41DBE44D7AA0B623.quest_desc: ["Tamirci Masası, hazırladığınız geliştirmeleri öz ekipmanlarınıza takmanızı sağlar!"]
	quest.42218A7D42CF0A4C.quest_subtitle: "Kademe: &a2"
	quest.4352505361D61BB2.quest_subtitle: "Kademe: &a2"
