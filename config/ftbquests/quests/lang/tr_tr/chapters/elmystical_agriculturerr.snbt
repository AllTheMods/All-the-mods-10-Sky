	quest.077B2D62FA7650FB.title: "&cTertium Büyüme Hızlandırıcısı"
	quest.0B37355262121DD5.quest_desc: ["&aİnfüzyon Sunağı&r, tüm tohumları üretme yönteminizdir. Önce İnfüzyon Sunağını yerleştirin; İnfüzyon Kaidelerinin nereye yerleştirileceğini size gösterecektir.\\n\\nİnfüzyonun başlaması için İnfüzyon Sunağının bir &4Redstone sinyaline&r ihtiyacı vardır."]
	quest.0B37355262121DD5.quest_subtitle: "Tohum Üretimi"
	quest.0B37355262121DD5.title: "&4İnfüzyon Sunağı"
	quest.0EFEDB0DD90DFC81.quest_desc: ["Hasatçı, ekinleri otomatik olarak toplayıp yeniden eker. Topladığı eşyaları kendi dahili envanterine depolar."]
	quest.13124A7E22999850.quest_subtitle: "Aşama: &e1"
	quest.15D764CAF047EA7A.title: "&cTertium Zırh&r"
	quest.1609BF52108238B0.quest_subtitle: "Aşama: &e1"
	quest.1636F3F12E92CAEA.quest_desc: [
		"Sulama Kabını kullanmak için öncelikle bir su kaynağı bloğuna sağ tıklayarak suyla doldurmalısınız. Dolduktan sonra etki alanındaki ekinleri sulamak için bir ekine sağ tıklayıp basılı tutabilirsiniz."
		""
		"Öz sulama kapları otomatik sulama özelliğine sahiptir. Otomatik sulamayı açıp kapatmak için elinizdeyken havada Shift + Sağ Tık yapmanız yeterlidir. Açıldığında sulama kabı büyülü gibi parlayacaktır."
	]
	quest.16E3031D800B40D5.quest_desc: ["Soulium Canavar Çağırıcı, yaratık çağırmak için yaratık özlerini kullanır. Örneğin içine bir miktar Ghast Özü koyarak Ghast oluşturabilirsiniz."]
	quest.1C2CF6253F8B32EE.quest_subtitle: "Kademe: &56"
	quest.1C4ABF4518638A82.quest_desc: ["Güçlendirmeler:\\n\\n - Hasar Emilimi II (3:00)\\n - Hız II (3:00)\\n - Direnç II (3:00)\\n - Yenilenme II (3:00)\\n - Kuvvet II (3:00)"]
	quest.1C4ABF4518638A82.title: "&4Supremium Elma"
	quest.1CC4F8570A7A99EB.quest_desc: ["&dÖz&r, Mystical Agriculture'daki tüm tarım ihtiyaçlarınızın başlangıç noktasıdır.\\n\\n&eInferium Özü&r, tüm özlerin ilk kademesidir. Madencilik yaparak, yaratıkları öldürerek veya tohumlarını ekip yetiştirerek elde edebilirsiniz!\\n\\nDaha üst kademe özler üretmek için bir &9İnfüzyon Kristali&r yapmanız gerekecek."]
	quest.1CC4F8570A7A99EB.quest_subtitle: "Aşama: &e1"
	quest.1CC4F8570A7A99EB.title: "&aInferium"
	quest.1CF8263756EE8F2A.quest_desc: ["Bu özel tozu (&eBilişsel Toz&r), Wither veya Ender Ejderhası'nı &dMistik Aydınlanma&r büyülü bir &dÖz Silahı&r ile katlettiğinizde elde edersiniz."]
	quest.1CF8263756EE8F2A.title: "&5Bilişsel Toz&r"
	quest.1E0F92F07FDD162E.quest_desc: ["Kaynak ekinleri yetiştirmek için &bProsperity Tohum Temellerine&r ihtiyacınız olacak."]
	quest.1E0F92F07FDD162E.quest_subtitle: "Her Şeyin Temeli"
