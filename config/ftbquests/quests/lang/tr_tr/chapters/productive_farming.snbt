	quest.3111C0CA63A82E7A.quest_desc: ["Blue Jade Corn, Yellow Dent Corn ve Cornflower ile yapılır. \\n\\nDemek Cornflower adında 'corn' (mısır) geçmesinin nedeni bu!"]
	quest.33C3C334981AF72E.quest_desc: ["Cherry Tomato ile onun ikinci evrimi (bu şakayı daha önce yapmadım mı?) Chocolate Pear Tomato birleşerek Yellow Pear Tomato oluşturabilir. \\n\\nSarı renk nereden geldi? Ya da yine armut?"]
	quest.383EDBE9AAAF4C99.quest_subtitle: "Mic Line"
	quest.3BB39CC4E8F40B67.quest_subtitle: "1,2... 1,2"
	quest.3CBF4D703AA17199.quest_desc: ["&a&lProductive Farming&r (bu görev hazırlanırken) en yeni Productive modudur. \\n\\nBu mod, otomatik çiftlik çoklu blok yapısını, yeni mahsulleri, daha fazla çiçeği ve onlar için yeni boya renklerini getirir! \\n\\nAyrıca &6&lProductive Bees&r ve &l&cD&6y&ee&an&ba&dm&ci&6c&es&r ile birlikte çalışır!"]
	quest.3CBF4D703AA17199.quest_subtitle: "Daha kaç mod yapacak?"
	quest.3CBF4D703AA17199.title: "&a&lProductive Farming"
	quest.3E57854E27545581.quest_desc: ["Orange Bell Pepper ile Yellow Bell Pepper'ın birleşimi."]
