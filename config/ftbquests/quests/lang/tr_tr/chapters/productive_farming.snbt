	quest.06B197EB778C17AC.quest_desc: ["&dÇiçekleri&r &6Çaprazladığımız&r gibi &2Mahsullerde&r de aynı işlemi yapabiliriz! \\n\\nBelirli &2Mahsullerin&r bulunduğu bir alanda &6Arılar Tozlaşma Yaptığında&r bazı mahsuller &6Mutasyona Uğrayabilir&r. \\n\\nHangi &2Mahsulleri&r çaprazlaman gerektiğini görmek için &lJEI&r'ye bak."]
	quest.06B197EB778C17AC.title: "&6Mutasyonlar"
	quest.095024BF19ABA326.quest_desc: ["Orange Bell Pepper ile Green Bell Pepper'ın birleşimi."]
	quest.0D04BCF5940E2AF1.quest_desc: ["Blue Jade Corn ile Black Aztec Corn'u birleştirmek Sugar Pearl Corn verir."]
	quest.126CCC6B187C0B18.quest_desc: ["Son olarak Black Aztec Corn ile Sugar Pearl Corn'u karıştırarak Rainbow Corn elde edebiliriz. "]
